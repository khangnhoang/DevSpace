{
  "permissions": {
    "ask": [
      "Bash(playwright-cli *attach*)",
      "Bash(playwright-cli *--cdp*)",
      "Bash(playwright-cli *--extension*)",
      "Bash(npx *playwright cli *attach*)",
      "Bash(npx *playwright cli *--cdp*)",
      "Bash(npx *playwright cli *--extension*)",
      "PowerShell(playwright-cli *attach*)",
      "PowerShell(playwright-cli *--cdp*)",
      "PowerShell(playwright-cli *--extension*)",
      "PowerShell(npx *playwright cli *attach*)",
      "PowerShell(npx *playwright cli *--cdp*)",
      "PowerShell(npx *playwright cli *--extension*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*__(apply_migration|execute_sql|deploy_edge_function|create_branch|delete_branch|merge_branch|rebase_branch|reset_branch|create_project|pause_project|restore_project)",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/db-command-guard.mjs\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking for hosted database commands"
          }
        ]
      }
    ]
  }
}
