# SQL checks out as LF on Windows too, so a local `db reset` replays the same bytes as CI and as hosted.
/supabase/migrations/*.sql text eol=lf
/supabase/rollbacks/*.sql text eol=lf

# Hosted `update_updated_at_column` has CRLF in its body; keep the baseline bytes exactly as dumped.
# This line comes after the pattern above, so it wins for the baseline.
/supabase/migrations/20261021000000_baseline.sql -text

# Vendored upstream LICENSE has CRLF line endings; keep its bytes so the blob SHA matches microsoft/playwright-cli.
/.claude/skills/playwright-cli/LICENSE -text whitespace=cr-at-eol
