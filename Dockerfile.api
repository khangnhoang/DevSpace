# Fallback build of the API for Railway, used only if Railpack cannot build on Node 26 (TM-U3 plan R1). To use it, set
# "builder": "DOCKERFILE" and "dockerfilePath": "Dockerfile.api" in railway.json; the default is Railpack. The image
# holds `dist` and the production dependencies only. Railway passes RAILWAY_GIT_COMMIT_SHA as a build argument and a
# runtime variable, and the process reads it at runtime for /api/health.
FROM node:26-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
# --ignore-scripts: the root postinstall copies Monaco for the Next app, which the API image does not hold.
RUN npm ci --ignore-scripts
COPY backend backend
COPY lib/schemas lib/schemas
COPY scripts/api/build.mjs scripts/api/build.mjs
RUN npm run build:api
RUN npm prune --omit=dev --ignore-scripts

FROM node:26-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
USER node
CMD ["node", "dist/backend/src/main.js"]
