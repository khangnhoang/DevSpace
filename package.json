{
  "name": "my-w3schools",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev/local.mjs",
    "monaco:copy": "node scripts/monaco/copy-vs.mjs",
    "postinstall": "npm run monaco:copy",
    "build": "next build",
    "start": "next start",
    "build:api": "npm run build --workspace backend",
    "typecheck:api": "npm run typecheck --workspace backend",
    "lint": "eslint --max-warnings 0",
    "lint:api": "npm run lint --workspace backend",
    "api:schema:pull": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/api/schema.mjs",
    "api:schema:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/api/schema.mjs --check",
    "format": "prettier --write --ignore-unknown",
    "format:check": "prettier --check --ignore-unknown",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-stack/test.mjs",
    "test:unit": "vitest run --project unit --project components",
    "test:e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e/run.mjs",
    "test:stack:stop": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-stack/stop.mjs",
    "backup:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backup/check.mjs",
    "docs:check-structure": "node scripts/docs/check-structure.mjs",
    "docs:check-skills": "node scripts/docs/check-skills.mjs",
    "docs:check-links": "node scripts/docs/check-links.mjs",
    "docs:check-instructions": "node scripts/docs/check-instructions.mjs",
    "docs:check": "npm run docs:check-structure && npm run docs:check-skills && npm run docs:check-links && npm run docs:check-instructions",
    "docs:check:test": "node --test scripts/docs/check-structure.test.mjs scripts/docs/check-skills.test.mjs scripts/docs/check-links.test.mjs scripts/docs/check-instructions.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@hookform/resolvers": "^7.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/typography": "^0.5.19",
    "@uiw/react-md-editor": "^4.1.6",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.554.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.4.5",
    "next-mdx-remote": "^6.0.0",
    "nodemailer": "^10.3.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-youtube": "^10.1.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-youtube": "^7.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    }
  }
}
